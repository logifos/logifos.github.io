---
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  page: 'home' | 'status' | 'scoreboard' | 'architecture' | 'api' | 'install' | 'migration';
}

const { title, description, page } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} — Logifos</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header frame">
      <a class="brand" href="/">Logifos</a>
      <nav aria-label="Main navigation">
        <a href="/status.html" aria-current={page === 'status' ? 'page' : undefined}>Status</a>
        <a href="/scoreboard.html" aria-current={page === 'scoreboard' ? 'page' : undefined}>Scoreboard</a>
        <a href="/architecture.html" aria-current={page === 'architecture' ? 'page' : undefined}>Architecture</a>
        <a href="/api.html" aria-current={page === 'api' ? 'page' : undefined}>API</a>
        <a href="/install.html" aria-current={page === 'install' ? 'page' : undefined}>Install</a>
        <a href="/migration.html" aria-current={page === 'migration' ? 'page' : undefined}>Migration</a>
        <a href="https://github.com/logifos">Source</a>
      </nav>
    </header>
    <main id="main" class="frame"><slot /></main>
    <footer class="site-footer frame">
      <p>© 2026 Ribose Inc. · <a href="/LICENSE.txt">MIT license</a></p>
      <p>Unreleased software and planned interfaces. Rendering is unavailable.</p>
    </footer>
  </body>
</html>
